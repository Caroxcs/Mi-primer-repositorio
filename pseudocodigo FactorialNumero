algoritmo FactorialNumero()
inicio
  Escribir "ingrese un numero positivo"
  leer n
  i = 1
  factorial = 1
  Mientras i <= n hacer
    factorial = factorial * i
    i = i + 1
  fin mientras 
  Escribir "El numero factorial es: ", factorial
fin 
  
